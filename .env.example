# ============================================================
# HOS-ARES 环境变量模板
# 复制为 .env 并填写实际值（.env 已被 .gitignore 忽略，勿提交）
# ============================================================

# ---------- 模型 API Key ----------
# 大模型服务商的 API Key（如 Anthropic / OpenAI / 兼容 OpenAI 的网关）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 可选：自定义模型网关地址（若使用代理或中转）
# LLM_BASE_URL=

# ---------- Reasonix 配置 ----------
# Reasonix Agent 相关配置
REASONIX_API_KEY=
# Reasonix 服务端口（Android 内本地服务）
REASONIX_PORT=8080

# ---------- 远程 Agent Server ----------
# 远程 Agent Server 地址（可选，用于远程调度）
AGENT_SERVER_HOST=
AGENT_SERVER_PORT=
AGENT_SERVER_TOKEN=

# ---------- Gateway 配置 ----------
# AI Agent Gateway 监听地址（Android 本地回环）
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9000

# ---------- Runtime 配置 ----------
# reasonix-proot-app / Alpine 相关（占位）
RUNTIME_ROOT=/data/local/tmp/hos-ares
ALPINE_MIRROR=https://mirrors.alpinelinux.org

# ---------- 其他 ----------
# 默认审计目标（占位）
DEFAULT_AUDIT_TARGET=
LOG_LEVEL=info
