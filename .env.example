# VeriPen 环境变量模板（真实值不入 git；.env 已在 .gitignore）
#
# 这里全部留空：路径值由部署环境注入，仓库内不出现任何可定位字面量（27 N3）。
# 校验：make bindings-check → 报告"环境待注入 N 项"
# 部署：make bindings-check STRICT=--strict-env → 缺一个就失败

# 服务监听（容器内）
VERIPEN_BIND_HOST=
VERIPEN_BIND_PORT=
VERIPEN_PUBLISH_PORT=

# 存储
VERIPEN_DB=out/veripen.db

# 操作路径（op_id → 实际路径，由部署注入）
OPS_TASK_SUBMIT=
OPS_TASK_GET=
OPS_TASK_LIST=
OPS_TASK_CANCEL=
OPS_TASK_REQUEUE=
OPS_FINDING_LIST=
OPS_FINDING_GET=
OPS_FINDING_FEEDBACK=
OPS_CAPSULE_GET=
OPS_CAPSULE_DOWNLOAD=
OPS_CAPSULE_REPLAY=
OPS_ROUTE_DISCOVER=
OPS_ROUTE_LIST=
OPS_ROUTE_EXPLAIN=
OPS_ROUTE_DIFF=
OPS_APPROVAL_LIST=
OPS_APPROVAL_DECIDE=
OPS_STATS_TASK=
OPS_STATS_ENGAGEMENT=
OPS_COVERAGE=
OPS_BOUNDS=
OPS_HEALTHZ=
OPS_READYZ=

# 资产标识（唯一允许出现的可定位字面量，见 02 §1）
ASSET_ENDPOINT_A=
