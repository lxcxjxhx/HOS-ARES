{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripen.local/schemas/dataset-manifest-v1.json",
  "title": "VeriPen Dataset Manifest v1",
  "description": "每份 data/ 下的数据集必须有此 manifest；缺失或不合法即 make data-verify 失败。",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "source", "license", "retrieved_at", "sha256", "rows", "fields", "pii"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$" },
    "source": {
      "enum": ["open-source-target", "public-dataset", "public-api-snapshot", "llm-synthetic"],
      "description": "llm-synthetic 仅当真实来源不可得时使用"
    },
    "source_url": { "type": "string" },
    "license": { "type": "string", "minLength": 2 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": { "type": "integer", "minimum": 200 },
    "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "distribution": {
      "type": "object",
      "description": "用于回归：数据分布变化即基线失效",
      "additionalProperties": true
    },
    "pii": { "const": false },
    "transform": { "type": "string", "description": "生成/清洗脚本路径" },
    "seed": { "type": "integer", "description": "llm-synthetic 必填" },
    "prompt_version": { "type": "string", "description": "llm-synthetic 必填" },
    "reviewed_by": { "type": "string", "description": "llm-synthetic 必填：人工抽检人" },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "llm-synthetic" } }, "required": ["source"] },
      "then": {
        "required": ["seed", "prompt_version", "reviewed_by", "transform"],
        "properties": {
          "source_url": { "type": "string", "description": "可留空或写 prompt 文件路径" }
        }
      }
    },
    {
      "if": {
        "properties": { "source": { "enum": ["public-dataset", "public-api-snapshot"] } },
        "required": ["source"]
      },
      "then": { "required": ["source_url", "transform"] }
    }
  ]
}
