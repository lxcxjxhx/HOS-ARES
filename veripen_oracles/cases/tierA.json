{
  "_note": "B5/B6 用例矩阵（07 §0.5）。正样本必须覆盖三种难度；负样本必须含'看似漏洞实则安全'与'环境退化'两类。每条只描述变换与期望，不含地址。",
  "sqli_bool_diff": {
    "positive": [
      {
        "case": "bool_diff_int",
        "params": {
          "nonce": "p1"
        },
        "expect": "VERIFIED",
        "why": "1=1 与 1=2 响应不同，对照同形"
      },
      {
        "case": "bool_diff_alt_nonce",
        "params": {
          "nonce": "p2"
        },
        "expect": "VERIFIED",
        "why": "nonce 变化不影响判定（判定不看 nonce 值）"
      },
      {
        "case": "bool_diff_repeat3",
        "params": {
          "nonce": "p3",
          "repeat": 3
        },
        "expect": "VERIFIED",
        "why": "repeat 提升后结论一致"
      },
      {
        "case": "bool_diff_quote_ctx",
        "params": {
          "nonce": "p4"
        },
        "expect": "VERIFIED",
        "why": "字符串上下文同样成立"
      }
    ],
    "negative": [
      {
        "case": "hardened_param_safe",
        "lab": "hardened",
        "expect": "REFUTED",
        "why": "参数化实现，任何条件都返回同页"
      },
      {
        "case": "degenerate_all_200",
        "lab": "degenerate",
        "expect": "REFUTED",
        "why": "整站同页：差分不存在"
      }
    ]
  },
  "idor_cross_account": {
    "positive": [
      {
        "case": "cross_account_1",
        "params": {
          "nonce": "i1"
        },
        "expect": "VERIFIED",
        "why": "非拥有者读到他人对象，锁定对象仍 403"
      },
      {
        "case": "cross_account_offset",
        "params": {
          "nonce": "i2",
          "locked_object_id": 4
        },
        "expect": "VERIFIED",
        "why": "对照对象可配"
      },
      {
        "case": "cross_account_repeat",
        "params": {
          "nonce": "i3",
          "repeat": 3
        },
        "expect": "VERIFIED",
        "why": "重复一致"
      },
      {
        "case": "cross_account_other_subject",
        "params": {
          "nonce": "i4",
          "subject_object_id": 3
        },
        "expect": "VERIFIED",
        "why": "换一条归属对象仍成立"
      }
    ],
    "negative": [
      {
        "case": "hardened_object_authz",
        "lab": "hardened",
        "expect": "REFUTED",
        "why": "有对象级鉴权"
      },
      {
        "case": "degenerate_all_200",
        "lab": "degenerate",
        "expect": "REFUTED",
        "why": "对照不成立，无法证明有对象级鉴权"
      }
    ]
  },
  "ssrf_oob": {
    "positive": [
      {
        "case": "oob_callback",
        "params": {
          "nonce": "s1"
        },
        "expect": "VERIFIED",
        "why": "服务端连了 OOB，控制无回调"
      },
      {
        "case": "oob_callback_2",
        "params": {
          "nonce": "s2"
        },
        "expect": "VERIFIED",
        "why": "新 nonce 独立成立"
      },
      {
        "case": "oob_callback_repeat3",
        "params": {
          "nonce": "s3",
          "repeat": 3
        },
        "expect": "VERIFIED",
        "why": "重复一致"
      },
      {
        "case": "oob_callback_4",
        "params": {
          "nonce": "s4"
        },
        "expect": "VERIFIED",
        "why": "同一绑定多次成立"
      }
    ],
    "negative": [
      {
        "case": "hardened_fetch_allowlist",
        "lab": "hardened",
        "expect": "REFUTED",
        "why": "取数域白名单"
      },
      {
        "case": "degenerate_all_200",
        "lab": "degenerate",
        "expect": "REFUTED",
        "why": "无回调"
      }
    ]
  },
  "jwt_replay": {
    "positive": [
      {
        "case": "alg_none_accepted",
        "params": {
          "nonce": "j1"
        },
        "expect": "VERIFIED",
        "why": "alg=none 被接受，原 token 200，无效签名 401"
      },
      {
        "case": "claim_tamper",
        "params": {
          "nonce": "j2",
          "escalate_role": "admin"
        },
        "expect": "VERIFIED",
        "why": "声明篡改后拿到特权标记"
      },
      {
        "case": "repeat3",
        "params": {
          "nonce": "j3",
          "repeat": 3
        },
        "expect": "VERIFIED",
        "why": "重复一致"
      },
      {
        "case": "escalate_sub",
        "params": {
          "nonce": "j4",
          "escalate_to": "primary"
        },
        "expect": "VERIFIED",
        "why": "换升级目标仍成立"
      }
    ],
    "negative": [
      {
        "case": "hardened_signature_check",
        "lab": "hardened",
        "expect": "REFUTED",
        "why": "签名强校验，alg=none 被拒"
      },
      {
        "case": "degenerate_all_200",
        "lab": "degenerate",
        "expect": "REFUTED",
        "why": "对照不成立（无法证明服务器校验签名）"
      }
    ]
  },
  "open_redirect": {
    "positive": [
      {
        "case": "abs_external",
        "params": {
          "nonce": "r1"
        },
        "expect": "VERIFIED",
        "why": "绝对外域目标被原样写进 Location"
      },
      {
        "case": "proto_relative",
        "params": {
          "nonce": "r2",
          "check_protocol_relative": true
        },
        "expect": "VERIFIED",
        "why": "协议相对 //host 形态同样跳出"
      },
      {
        "case": "repeat3",
        "params": {
          "nonce": "r3",
          "repeat": 3
        },
        "expect": "VERIFIED",
        "why": "重复一致"
      },
      {
        "case": "no_proto_relative_check",
        "params": {
          "nonce": "r4",
          "check_protocol_relative": false
        },
        "expect": "VERIFIED",
        "why": "关掉协议相对探针仍能靠绝对形态成立"
      }
    ],
    "negative": [
      {
        "case": "hardened_same_site_only",
        "lab": "hardened",
        "expect": "REFUTED",
        "why": "只接受相对路径，外域目标被拒"
      },
      {
        "case": "degenerate_all_200",
        "lab": "degenerate",
        "expect": "REFUTED",
        "why": "没有 Location 头，根本谈不上跳转"
      }
    ]
  },
  "path_traversal": {
    "positive": [
      {
        "case": "plain_dotdot",
        "params": {
          "nonce": "t1"
        },
        "expect": "VERIFIED",
        "why": "纯 ../ 读到系统文件特征内容"
      },
      {
        "case": "percent_encoded",
        "params": {
          "nonce": "t2",
          "max_encoded_variants": 3
        },
        "expect": "VERIFIED",
        "why": "百分号编码变体同样成立"
      },
      {
        "case": "repeat3",
        "params": {
          "nonce": "t3",
          "repeat": 3
        },
        "expect": "VERIFIED",
        "why": "重复一致"
      },
      {
        "case": "no_encoded_variants",
        "params": {
          "nonce": "t4",
          "max_encoded_variants": 0
        },
        "expect": "VERIFIED",
        "why": "只靠基础变体即成立"
      }
    ],
    "negative": [
      {
        "case": "hardened_basename_check",
        "lab": "hardened",
        "expect": "REFUTED",
        "why": "含 .. 一律拒绝；基线仍可读"
      },
      {
        "case": "degenerate_all_200",
        "lab": "degenerate",
        "expect": "REFUTED",
        "why": "整站同页，无系统文件指纹"
      }
    ]
  }
}